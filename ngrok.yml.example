version: 2

# Replace with your own ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
authtoken: YOUR_NGROK_AUTH_TOKEN_HERE

# Define three tunnels: frontend (Vite), backend (Express), and demo site
tunnels:
  frontend:
    addr: 3000
    proto: http
  backend:
    addr: 3001
    proto: http
  demo:
    addr: 3002
    proto: http
